# ---------------------------------------------------------------- dependencies
node_modules/
.pnp
.pnp.js

# --------------------------------------------------------------------- next.js
/.next/
/out/
/.swc/

# ----------------------------------------------------------------- build output
/build

# ----------------------------------------------------------------------- misc
.DS_Store
Thumbs.db
*.pem

# ----------------------------------------------------------------------- debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------- environment files
# `.env` is deliberately *not* committed: GitHub push protection rejects any file
# holding `NEXT_PUBLIC_MAPBOX_TOKEN` (`GH013: Push cannot contain secrets`), even
# though the value is a public (`pk.*`) token. Locally `.env` still works; on CI
# the value comes from an Actions variable/secret (see .github/workflows/deploy.yml).
.env
.env.local
.env*.local
.env.development
.env.production

# --------------------------------------------------------------------- hosting
.vercel

# ------------------------------------------------------------------------- ide
.idea/
*.swp

# ---------------------------------------------------------- article publishing
# Article images and covers are authored next to their MDX in `content/blog/<dir>/`
# and copied to `public/blog/<dir>/` by `npm run gen:articles`. A static export only
# publishes what lives under `public/`, but those copies are build output.
/public/blog/*/
/lib/generated/
/public/search-index.json

# ----------------------------------------------------------- agent scratch dir
# Working notes and one-off tools an agent leaves behind. Not part of the site,
# and without this rule they sit in `git status` as untracked and are one
# `git add .` away from being published with the blog.
.workbuddy-ai/
