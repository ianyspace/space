        "gen:articles": "node scripts/gen-article-registry.js",
        "lint": "next lint"
    },
    "dependencies": {
        "github-slugger": "^2.0.0",
        "gray-matter": "^4.0.3",
        "hast-util-to-string": "^3.0.1",
        "katex": "^0.16.47",
        "mapbox-gl": "^2.15.0",
        "mdast-util-to-string": "^4.0.0",
        "next": "^15.5.4",
        "next-mdx-remote": "^5.0.0",
        "prop-types": "^15.8.1",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "reading-time": "^1.5.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-external-links": "^3.0.0",
        "rehype-katex": "^7.0.1",
        "rehype-prism-plus": "^2.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "typography": "^0.16.24",
